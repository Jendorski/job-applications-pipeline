# Copy to .env (gitignored). docker compose loads it automatically; locally use `uv run --env-file .env jap …`.

# anthropic (default) | openai_compat
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Models. With LLM_PROVIDER=anthropic both default to Claude Opus 5.5 ($4 / $20 per million tokens
# in / out); cheaper options are claude-sonnet-5-5 ($2 / $10) or claude-haiku-5-5 ($0.10 / $0.50).
# With LLM_PROVIDER=openai_compat there is no default: set both to names your endpoint serves.
MODEL_EXTRACT=claude-opus-5-5
MODEL_TAILOR=claude-opus-5-5
EFFORT_EXTRACT=low
EFFORT_TAILOR=medium

# Output-token ceiling for the tailoring call (reasoning tokens count toward it).
# Default 16000 for Claude (the SDK's non-streaming limit), 32000 for openai_compat.
# MAX_TOKENS_TAILOR=32000

# Server-side refusal fallback on models that support it (1 = on).
LLM_FALLBACKS=1

# New jobs pause once this month's LLM spend reaches the cap.
MONTHLY_BUDGET_USD=10

# The watcher deletes application folders older than this once a day. Folders of jobs marked
# applied/interviewing/offer are kept. 0 turns cleanup off.
APPLICATIONS_KEEP_DAYS=30

# Only for LLM_PROVIDER=openai_compat (OpenAI, OpenRouter, Ollama at http://host.docker.internal:11434/v1, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Prices, USD per million tokens: [input, output, cache read, cache write]. Claude models are built in.
# For other models, costs show as n/a and the monthly budget cap is not enforced until you add them here.
# LLM_PRICES={"my-local-model": [0, 0, 0, 0]}
